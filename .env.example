# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Flask session signing key. Generate a long random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Path to the SQLite database file.
DATABASE_URL=

# Third-party API keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Public base URL of the deployed app (e.g. https://app.example.com).
APP_URL=

# Google SSO (optional). Leave blank to disable the "Continue with Google"
# button. Create an OAuth 2.0 "Web application" client in Google Cloud Console
# and add the redirect URI https://<your-host>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to "false" only for local HTTP development so the session cookie isn't
# marked Secure (which would prevent it being sent over plain http://localhost).
SESSION_COOKIE_SECURE=

# How many items the worker processes at once (default 3, max 10). Governs both
# the PDP-scoring and Copy-Content pools (they run one at a time, never together).
# Each concurrent item is a full headed Chrome, so this is memory-bound: keep it
# at 2-3 on a ~2 GB droplet and raise it only after adding RAM. Leave blank for
# the default.
SCORING_CONCURRENCY=

# Residential proxy for Competitive Intelligence search scraping (optional).
# Walmart's ad exchange serves headline/sponsored-video ads only to residential-
# looking clients, so the droplet's datacenter IP gets ~zero ad fill. Set a
# residential proxy endpoint here to route the CI scrape through it. Leave
# WALMART_PROXY_SERVER blank to scrape directly (the default). USERNAME/PASSWORD
# are only needed if the provider authenticates.
WALMART_PROXY_SERVER=
WALMART_PROXY_USERNAME=
WALMART_PROXY_PASSWORD=

# AI image upscaling for the low-resolution images content scoring flags (optional).
# Inert until IMAGE_UPSCALE_API_KEY is set — the "Enhance to 2000px" link is hidden
# otherwise. Provider is Claid.ai (e-commerce-tuned conservative super-resolution).
# MODE is Claid's upscale mode (smart_enhance|smart_resize|photo|faces|digital_art);
# TARGET_PX is the longest-edge target; OUTPUT_FORMAT is jpeg or png.
IMAGE_UPSCALE_PROVIDER=claid
IMAGE_UPSCALE_API_KEY=
IMAGE_UPSCALE_MODE=smart_enhance
IMAGE_UPSCALE_TARGET_PX=2000
IMAGE_UPSCALE_OUTPUT_FORMAT=jpeg
