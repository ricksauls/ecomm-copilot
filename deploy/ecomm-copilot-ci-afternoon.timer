# Fires the afternoon monitoring slot at 3:00 PM Central. The sweep runs once a day
# at a rotating time, so this enqueues only on the days app.scrape_rotation picks
# "afternoon" (it no-ops otherwise). Timezone in OnCalendar handles CST/CDT
# automatically (droplet clock is UTC).
#
# Install at /etc/systemd/system/ecomm-copilot-ci-afternoon.timer, then
# `systemctl enable --now ecomm-copilot-ci-afternoon.timer`.

[Unit]
Description=ecomm-copilot CI monitoring — afternoon (3:00 PM CST)

[Timer]
OnCalendar=*-*-* 15:00:00 America/Chicago
Persistent=true
Unit=ecomm-copilot-ci-monitor@afternoon.service

[Install]
WantedBy=timers.target
