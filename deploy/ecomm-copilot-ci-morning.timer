# Fires the morning monitoring slot at 7:00 AM Central. The sweep runs once a day
# at a rotating time, so this enqueues only on the days app.scrape_rotation picks
# "morning" (it no-ops otherwise). The explicit timezone in OnCalendar makes systemd
# handle CST/CDT automatically (the droplet clock is UTC), so no manual offset
# upkeep — unlike the WM scraper's UTC cron.
#
# Install at /etc/systemd/system/ecomm-copilot-ci-morning.timer, then
# `systemctl enable --now ecomm-copilot-ci-morning.timer`.

[Unit]
Description=ecomm-copilot CI monitoring — morning (7:00 AM CST)

[Timer]
OnCalendar=*-*-* 07:00:00 America/Chicago
Persistent=true
Unit=ecomm-copilot-ci-monitor@morning.service

[Install]
WantedBy=timers.target
