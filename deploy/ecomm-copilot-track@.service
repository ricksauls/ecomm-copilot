# Templated oneshot that enqueues item-tracking work for every tracked portfolio
# item. The instance name (%i) is the cadence: daily | weekly.
#   daily  -> a cheap commerce-facts fetch per tracked item (price/stock/rating/
#             reviews), via the portfolio_fact_jobs queue.
#   weekly -> a full content-readiness re-score per tracked item (reuses the
#             scored_items queue).
# Triggered by the ecomm-copilot-track-*.timer units. This only writes queued rows
# — the ecomm-copilot-worker does the actual browser work — so it needs no DISPLAY
# and finishes in milliseconds.
#
# Install at /etc/systemd/system/ecomm-copilot-track@.service
# (setup-droplet.sh does this).

[Unit]
Description=ecomm-copilot item-tracking enqueue (%i)
After=network.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/apps/ecomm-copilot
EnvironmentFile=/home/deploy/apps/ecomm-copilot/.env
ExecStart=/home/deploy/apps/ecomm-copilot/venv/bin/python -m app.enqueue_item_tracking %i

# Least-privilege hardening (matching the other units).
NoNewPrivileges=true
PrivateTmp=true
